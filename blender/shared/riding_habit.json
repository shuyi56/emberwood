  "fabrics": {
    "_doc": "thick_u: the cloth's thickness as built, in scene units (from the garment's code, quoted in 'from'). stretch: the share of its length the cloth gives at a comfortable pull along the girth (woven on the grain about 0.01 to 0.03, knit 0.3). turn: how much of its own thickness a cloth needs as turn of cloth (pi * thick * turn added to its girth: the inner face is shorter than the outer); 1 for a stiff, thick cloth, under 0.5 for a soft one. rigid: boned or lasted, holds its shape against the body's movement under it. bridge_u: the span the cloth bridges instead of following what is under it (its bending stiffness at this scale, in units: a fulled broadcloth with its lining lies smooth over about 2.6 cm, a fine linen follows anything over 5 mm); relief of the layer beneath narrower than this should not print through it.",
    "linen": {
      "thick_u": 0.0157,
      "bridge_u": 0.2,
      "from": "chemise/drape.py thick 0.008 w",
      "stretch": 0.03,
      "turn": 0.3
    },
    "coutil": {
      "thick_u": 0.1125,
      "bridge_u": 1.5,
      "from": "shared/habit.py CORSET_THICK 0.012 H (two layers and the bone channels)",
      "stretch": 0.0,
      "turn": 1.0,
      "rigid": true
    },
    "cotton": {
